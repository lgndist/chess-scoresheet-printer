<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows.Data.Pdf (rapor önizlemesi) için; Windows 10 1809 ve sonrası. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NotasyonOtomasyonu.App</RootNamespace>
    <AssemblyName>ChessScoresheetPrinter</AssemblyName>
    <Product>Chess Scoresheet Printer</Product>
    <Authors>Tunahan Dilercan</Authors>
    <Description>Satranç turnuvaları için hazır notasyon kâğıdı yazdırma aracı.</Description>
    <Version>1.6.3</Version>
    <FileVersion>1.6.3.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pencere ikonu (tek dosya exe'de de çalışsın diye gömülü). Başlık logosu vektör olarak çizilir. -->
    <EmbeddedResource Include="..\..\assets\app.ico">
      <LogicalName>NotasyonOtomasyonu.App.app.ico</LogicalName>
    </EmbeddedResource>
    <!-- Varsayılan hazır kağıt şablonu (kullanıcının ana örneği). -->
    <EmbeddedResource Include="..\..\assets\AnaOrnek.png">
      <LogicalName>NotasyonOtomasyonu.App.AnaOrnek.png</LogicalName>
    </EmbeddedResource>
    <!-- Gömülü yönerge/rapor şablonu ({{ALAN}} işaretli .docx). -->
    <EmbeddedResource Include="..\..\assets\turnuva_yonergesi_sablon.docx">
      <LogicalName>NotasyonOtomasyonu.App.turnuva_yonergesi_sablon.docx</LogicalName>
    </EmbeddedResource>
    <!-- Kart/yaka kartı yazı tipleri (SIL OFL; yalnız kalın kesim, Latin + Türkçe alt küme). -->
    <EmbeddedResource Include="..\..\assets\fonts\Montserrat-Bold.ttf" LogicalName="NotasyonOtomasyonu.App.fonts.Montserrat-Bold.ttf" />
    <EmbeddedResource Include="..\..\assets\fonts\Oswald-Bold.ttf" LogicalName="NotasyonOtomasyonu.App.fonts.Oswald-Bold.ttf" />
    <EmbeddedResource Include="..\..\assets\fonts\Inter-Bold.ttf" LogicalName="NotasyonOtomasyonu.App.fonts.Inter-Bold.ttf" />
    <!-- Resmi logolar: GSB ve TSF (alt yazısı silinmiş taban; il adı çalışırken çizilir). -->
    <EmbeddedResource Include="..\..\assets\logos\gsb.png" LogicalName="NotasyonOtomasyonu.App.logos.gsb.png" />
    <EmbeddedResource Include="..\..\assets\logos\tsf_base.png" LogicalName="NotasyonOtomasyonu.App.logos.tsf_base.png" />
    <EmbeddedResource Include="..\..\assets\turnuva_sonu_raporu_sablon.docx">
      <LogicalName>NotasyonOtomasyonu.App.turnuva_sonu_raporu_sablon.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\teknik_toplanti_tutanagi_sablon.docx">
      <LogicalName>NotasyonOtomasyonu.App.teknik_toplanti_tutanagi_sablon.docx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Overlay önizleme PDF'i için (doğrudan kullanım). -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Parsers\Parsers.csproj" />
    <ProjectReference Include="..\Render\Render.csproj" />
    <ProjectReference Include="..\Online\Online.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- config.json exe yanına kopyalansın (yoksa varsayılan üretilir). -->
    <None Include="..\..\config.json" Condition="Exists('..\..\config.json')">
      <Link>config.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
