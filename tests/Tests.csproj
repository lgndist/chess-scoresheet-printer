<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>NotasyonOtomasyonu.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Offline parser testleri için kaydedilmiş chess-results HTML örnekleri -->
    <None Include="TestData\*.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\turnuva_yonergesi_sablon.docx" Link="TestData\turnuva_yonergesi_sablon.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\teknik_toplanti_tutanagi_sablon.docx" Link="TestData\teknik_toplanti_tutanagi_sablon.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\turnuva_sonu_raporu_sablon.docx" Link="TestData\turnuva_sonu_raporu_sablon.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Core\Core.csproj" />
    <ProjectReference Include="..\src\Parsers\Parsers.csproj" />
    <ProjectReference Include="..\src\Render\Render.csproj" />
    <ProjectReference Include="..\src\Online\Online.csproj" />
  </ItemGroup>

</Project>
